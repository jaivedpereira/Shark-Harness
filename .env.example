# Copie para .env e preencha. NUNCA comite o .env.
# (aceita também o prefixo antigo NH_ — ver nh/paths.py)

# ── LLM do agente (`nh run` e a interface web) ─────────────────────────────
# Default verificado funcionando (modelos :free do OpenRouter):
SHARK_LLM_URL=https://openrouter.ai/api/v1/chat/completions
SHARK_LLM_MODEL=nvidia/nemotron-3.5-lightning:free
SHARK_LLM_KEY=

# Alternativas:
#   Groq        https://api.groq.com/openai/v1/chat/completions
#   DeepSeek    https://api.deepseek.com/v1/chat/completions
#   Ollama local (grátis, offline)  http://localhost:11434/v1/chat/completions
#
# Obs.: o opencode.ai/zen tem os grátis travados ("free tier can only be used
# from within OpenCode") e os pagos exigem saldo na conta.

# ── Limites de risco ──────────────────────────────────────────────────────
# safe | write | exec | danger  (default: exec)
SHARK_MAX_RISK=exec

# ── Caminhos (opcionais) ──────────────────────────────────────────────────
# SHARK_HOME=/caminho/para/config-e-jobs
# SHARK_WORKSPACE=/caminho/para/arquivos-do-agente
